# Public site URL. Drives canonical links, the sitemap, robots.txt and the CMS
# site_url. When the custom domain goes live, change this one value and redeploy.
PUBLIC_SITE_URL=https://thesociety-sable.vercel.app

# Optional. Overrides the DecapBridge site id checked into
# src/pages/admin/config.yml.ts. Only needed if a second site points at a
# different bridge.
DECAPBRIDGE_SITE_ID=
