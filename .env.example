# GitHub OAuth app credentials, used only by /api/auth and /api/callback
# so board members can sign into the CMS at /admin/.
# Create the app at https://github.com/settings/developers
#   Homepage URL:               https://<your-domain>
#   Authorization callback URL: https://<your-domain>/api/callback
GITHUB_OAUTH_ID=
GITHUB_OAUTH_SECRET=

# Set this to your DecapBridge site id to switch the editor to Decap CMS with
# Google sign-in (board members accept an email invite, no GitHub account).
# Leave it EMPTY to fall back to Sveltia CMS + GitHub sign-in.
# Find it at https://decapbridge.com -> your site -> config snippet.
DECAPBRIDGE_SITE_ID=

# Public site URL, used for canonical links and the sitemap.
PUBLIC_SITE_URL=https://the-society.vercel.app
