---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import { formatEvent } from '../../lib/dates';

const now = new Date();
const all = await getCollection('events', ({ data }) => !data.draft);

const upcoming = all
  .filter((e) => (e.data.end ?? e.data.start) >= now)
  .sort((a, b) => a.data.start.getTime() - b.data.start.getTime());

const past = all
  .filter((e) => (e.data.end ?? e.data.start) < now)
  .sort((a, b) => b.data.start.getTime() - a.data.start.getTime())
  .slice(0, 12);

const dayFmt = new Intl.DateTimeFormat('en-US', { day: 'numeric', timeZone: 'UTC' });
const monthFmt = new Intl.DateTimeFormat('en-US', { month: 'short', timeZone: 'UTC' });
const shortFmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeZone: 'UTC' });
---

<BaseLayout
  title="Events"
  description="Lectures, tours, the Ghost Walk and Sounds on the Square at the MHC Heritage Center & Museum."
>
  <PageHeading
    eyebrow="What's on"
    title="Events"
    lede="Lectures, tours, music on the square and the Ghost Walk. Board meetings are open to the public."
  />

  <h2 class="font-display text-3xl">Upcoming</h2>
  {
    upcoming.length === 0 ? (
      <p class="mt-4 text-ink-muted">Nothing scheduled right now. Check back soon.</p>
    ) : (
      <ul class="mt-6 space-y-10">
        {upcoming.map((event) => (
          <li class="grid gap-6 border-b border-rule pb-10 last:border-0 sm:grid-cols-[minmax(0,18rem)_1fr] sm:gap-8">
            {/*
              Posters carry their own text, so they are mounted rather than
              cropped: object-contain on a warm ground keeps a tall poster and
              a wide banner both legible in the same row.
            */}
            {event.data.image ? (
              <img
                src={event.data.image}
                alt={event.data.imageAlt ?? event.data.title}
                loading="lazy"
                decoding="async"
                class="aspect-4/3 w-full rounded-lg bg-parchment-deep object-contain"
              />
            ) : (
              <div class="flex aspect-4/3 w-full items-center justify-center rounded-lg bg-parchment-deep">
                <p class="text-center">
                  <span class="block font-display text-4xl text-brick">{dayFmt.format(event.data.start)}</span>
                  <span class="label block text-ink-muted">{monthFmt.format(event.data.start)}</span>
                </p>
              </div>
            )}

            <div>
              <p class="label text-brick">{formatEvent(event)}</p>
              <h3 class="mt-2 font-display text-2xl leading-snug">{event.data.title}</h3>
              {event.data.location && <p class="mt-1 text-sm text-ink-muted">{event.data.location}</p>}
              {event.data.summary && (
                <p class="mt-3 max-w-2xl leading-relaxed text-ink-muted">{event.data.summary}</p>
              )}
              {event.data.rsvpUrl && (
                <p class="mt-5">
                  <a
                    href={event.data.rsvpUrl}
                    rel="noopener"
                    class="inline-block rounded-full bg-brick px-5 py-2.5 text-sm font-semibold text-card transition-colors hover:bg-brick-bright"
                  >
                    Tickets and reservations
                  </a>
                </p>
              )}
            </div>
          </li>
        ))}
      </ul>
    )
  }

  {
    past.length > 0 && (
      <section class="mt-16">
        <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-rule pb-3">
          <h2 class="font-display text-3xl">Recently past</h2>
          <p class="text-sm text-ink-muted">What the Society has been running</p>
        </div>
        <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {past.map((event) => (
            <li>
              {event.data.image ? (
                <img
                  src={event.data.image}
                  alt={event.data.imageAlt ?? event.data.title}
                  loading="lazy"
                  decoding="async"
                  class="aspect-4/3 w-full rounded-lg bg-parchment-deep object-contain"
                />
              ) : (
                <div class="aspect-4/3 w-full rounded-lg border border-rule bg-parchment-deep" aria-hidden="true" />
              )}
              <p class="mt-3 text-sm text-ink-muted">{shortFmt.format(event.data.start)}</p>
              <h3 class="mt-0.5 font-display text-lg leading-snug">{event.data.title}</h3>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
