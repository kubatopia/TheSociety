---
/**
 * The CMS shell.
 *
 * Decap CMS talking to DecapBridge: a board member accepts an email invitation
 * and signs in with Google. Nobody needs a GitHub account. See DECISIONS.md
 * (DECISION-001) for why, and for what this replaced.
 *
 * DecapBridge's PKCE sign-in needs Decap 3.8.3 or above.
 */
const DECAP = 'https://unpkg.com/decap-cms@3.16.2/dist/decap-cms.js';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Content - MHC Historical Society</title>
  </head>
  <body>
    <script src={DECAP} is:inline></script>
  </body>
</html>
