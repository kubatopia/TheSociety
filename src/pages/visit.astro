---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import SectionNav from '../components/SectionNav.astro';
import OpenStatus from '../components/OpenStatus.astro';
import site from '../data/site.json';
import { summarise, closedDays, type OpeningDay } from '../lib/hours';

const hours = summarise(site.openingHours as OpeningDay[]);
const closed = closedDays(site.openingHours as OpeningDay[]);

const directions = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(
  `${site.venue}, ${site.address}, ${site.addressLine2}`,
)}`;

/** Sections the board has not filled in stay out of the index as well as the page. */
const sections = [
  { id: 'getting-here', label: 'Getting here' },
  site.parking && { id: 'parking', label: 'Parking' },
  site.admission && { id: 'admission', label: 'Admission' },
  site.accessibility && { id: 'accessibility', label: 'Accessibility' },
  { id: 'groups', label: 'Groups and schools' },
  { id: 'rentals', label: 'Renting the building' },
  { id: 'shop', label: 'The gift shop' },
].filter(Boolean) as Array<{ id: string; label: string }>;
---

<BaseLayout title="Plan your visit" description={`Hours, directions and admission for the ${site.venue}.`}>
  <PageHeading
    eyebrow="Plan your visit"
    title={site.venue}
    lede="The former Henry County courthouse, on the square at the top of Main Street. Two floors of exhibits, the historic courtroom upstairs, and the King Collections in the annex behind - all open on a standard visit."
  />

  <div class="grid gap-12 lg:grid-cols-[1fr_20rem] lg:gap-14">
    <div>
      <figure>
        <img
          src="/media/courthouse-golden-hour.jpg"
          alt={site.heroAlt}
          class="w-full rounded-[1.125rem] object-cover"
          loading="eager"
          decoding="async"
        />
        <figcaption class="mt-3 text-sm text-ink-muted">
          The museum from West Main Street. Visitor entrance is on the right-hand side.
        </figcaption>
      </figure>

      <!-- Index, so nobody has to scroll to find parking. -->
      <div class="mt-10 border-y border-rule py-5 lg:hidden">
        <SectionNav sections={sections} />
      </div>

      <section id="getting-here" class="mt-12 scroll-mt-28">
        <h2 class="font-display text-3xl">Getting here</h2>
        <p class="mt-4 max-w-2xl leading-relaxed text-ink-muted">
          The museum sits on the courthouse square at {site.address}, at the top of Main Street in
          downtown Martinsville. The building is the one with the white portico and the green roof -
          it is hard to miss.
        </p>
        {site.gettingHere && (
          <p class="mt-4 max-w-2xl leading-relaxed whitespace-pre-line text-ink-muted">{site.gettingHere}</p>
        )}
        <p class="mt-6">
          <a
            href={directions}
            class="inline-block rounded-full bg-brick px-5 py-3 text-sm font-semibold text-card transition-colors hover:bg-brick-bright"
            rel="noopener"
          >
            Get directions
          </a>
        </p>
      </section>

      {
        site.parking && (
          <section id="parking" class="mt-14 scroll-mt-28">
            <h2 class="font-display text-3xl">Parking</h2>
            <p class="mt-4 max-w-2xl leading-relaxed whitespace-pre-line text-ink-muted">{site.parking}</p>
          </section>
        )
      }

      {
        site.admission && (
          <section id="admission" class="mt-14 scroll-mt-28">
            <h2 class="font-display text-3xl">Admission</h2>
            <p class="mt-4 max-w-2xl leading-relaxed text-ink-muted">{site.admission}</p>
          </section>
        )
      }

      {
        site.accessibility && (
          <section id="accessibility" class="mt-14 scroll-mt-28">
            <h2 class="font-display text-3xl">Accessibility</h2>
            <p class="mt-4 max-w-2xl leading-relaxed whitespace-pre-line text-ink-muted">{site.accessibility}</p>
          </section>
        )
      }

      <section id="groups" class="mt-14 scroll-mt-28">
        <h2 class="font-display text-3xl">Groups and schools</h2>
        {
          site.groupsImage && (
            <img
              src={site.groupsImage}
              alt={site.groupsImageAlt}
              loading="lazy"
              decoding="async"
              class="mt-5 w-full rounded-[1.125rem] object-cover"
            />
          )
        }
        <div class="mt-4 max-w-2xl space-y-4 leading-relaxed text-ink-muted">
          <p>
            The museum offers guided tours to school classes and community groups, and Society
            specialists give talks on a range of local topics - the furniture and textile years,
            the tobacco market, the Speedway, or the building itself.
          </p>
          <p>
            Tours run during opening hours and can be arranged outside them for larger groups.
            Get in touch with a rough date, group size and what you would like to focus on, and
            the Society will work out the rest.
          </p>
        </div>
        <p class="mt-5">
          <a href={`mailto:${site.email}`} class="font-medium text-brick underline underline-offset-4 hover:text-brick-bright">
            Arrange a group visit
          </a>
        </p>
      </section>

      <section id="rentals" class="mt-14 scroll-mt-28">
        <h2 class="font-display text-3xl">Renting the building</h2>
        {
          site.rentalsImage && (
            <img
              src={site.rentalsImage}
              alt={site.rentalsImageAlt}
              loading="lazy"
              decoding="async"
              class="mt-5 w-full rounded-[1.125rem] object-cover"
            />
          )
        }
        <div class="mt-4 max-w-2xl space-y-4 leading-relaxed text-ink-muted">
          <p>
            The courthouse is available to hire for weddings, receptions, meetings, reunions and
            shows. It is a working piece of Henry County history rather than a function room, which
            is most of the appeal - the portico, the courtroom and the grounds all photograph well.
          </p>
          <p>
            Rates depend on the space and the day. Contact the Society for availability and to
            arrange a look around before you book.
          </p>
        </div>
        <p class="mt-5">
          <a href={`mailto:${site.email}`} class="font-medium text-brick underline underline-offset-4 hover:text-brick-bright">
            Ask about hiring the building
          </a>
        </p>
      </section>
      <section id="shop" class="mt-14 scroll-mt-28">
        <h2 class="font-display text-3xl">The gift shop</h2>
        <div class="mt-4 max-w-2xl space-y-4 leading-relaxed text-ink-muted">
          <p>
            The Heritage gift shop carries books on Martinsville and Henry County history -
            including titles you will not easily find elsewhere - alongside toys, sundries and
            small gifts.
          </p>
          <p>
            It is just inside the entrance, so you can browse without paying for admission, and
            everything it takes goes back into running the museum.
          </p>
        </div>
      </section>
    </div>

    <!-- The card the visitor came for. Sticky, so it stays with them. -->
    <aside class="lg:sticky lg:top-24 lg:h-fit">
      <div class="rounded-[1.125rem] border border-rule bg-card p-6">
        <OpenStatus />

        <h2 class="label mt-5 text-brick">Hours</h2>
        <ul class="mt-2 space-y-1 text-[0.9375rem]">
          {hours.map((line) => <li>{line}</li>)}
          {closed.length > 0 && <li class="text-ink-muted">Closed {closed.join(' and ')}.</li>}
        </ul>

        <h2 class="label mt-6 text-brick">Address</h2>
        <p class="mt-2 text-[0.9375rem]">{site.address}<br />{site.addressLine2}</p>

        {site.admission && (
          <>
            <h2 class="label mt-6 text-brick">Admission</h2>
            <p class="mt-2 text-[0.9375rem]">{site.admission}</p>
          </>
        )}
        {site.allowTime && (
          <>
            <h2 class="label mt-6 text-brick">Allow</h2>
            <p class="mt-2 text-[0.9375rem]">{site.allowTime}</p>
          </>
        )}

        <h2 class="label mt-6 text-brick">Contact</h2>
        <p class="mt-2 text-[0.9375rem]">
          <a href={`tel:${site.phone.replace(/[^\d+]/g, '')}`} class="hover:text-brick">{site.phone}</a><br />
          <a href={`mailto:${site.email}`} class="break-all text-ink-muted hover:text-brick">{site.email}</a>
        </p>

        <a
          href={directions}
          class="mt-6 block rounded-full bg-gold px-5 py-3 text-center text-sm font-semibold text-gold-ink transition-colors hover:bg-sand"
          rel="noopener"
        >
          Get directions
        </a>
      </div>

      <div class="mt-8 hidden lg:block">
        <SectionNav sections={sections} />
      </div>
    </aside>
  </div>
</BaseLayout>
