---
interface Props {
  title: string;
  lede?: string;
  eyebrow?: string;
}
const { title, lede, eyebrow } = Astro.props;
---

<div class="mb-12 max-w-3xl border-b border-rule pb-8">
  {eyebrow && <p class="text-xs font-semibold uppercase tracking-wider text-brick">{eyebrow}</p>}
  <h1 class="mt-2 font-display text-4xl font-semibold leading-tight tracking-tight sm:text-5xl">{title}</h1>
  {lede && <p class="mt-4 text-lg leading-relaxed text-ink-muted">{lede}</p>}
</div>
