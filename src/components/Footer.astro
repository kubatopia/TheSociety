---
import site from '../data/site.json';
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-rule">
  <div class="mx-auto flex max-w-5xl flex-wrap justify-between gap-6 px-5 py-10 text-sm text-ink-muted">
    <div>
      <p class="font-medium text-ink">{site.name}</p>
      {site.address && <p>{site.address}</p>}
      {site.email && <p><a href={`mailto:${site.email}`} class="hover:text-ink">{site.email}</a></p>}
    </div>
    <div class="text-right">
      <p>&copy; {year} {site.name}</p>
      <p><a href="/admin/" class="hover:text-ink">Board login</a></p>
    </div>
  </div>
</footer>
