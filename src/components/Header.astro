---
const links = [
  { href: '/about', label: 'About' },
  { href: '/museum', label: 'Museum' },
  { href: '/events', label: 'Events' },
  { href: '/news', label: 'News' },
  { href: '/board', label: 'Board' },
  { href: '/minutes', label: 'Minutes' },
  { href: '/contact', label: 'Visit' },
];

const { pathname } = Astro.url;
const isCurrent = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
---

<header class="sticky top-0 z-50 border-b border-rule bg-parchment/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-5 py-4">
    <a href="/" class="group flex items-baseline gap-2.5">
      <span class="font-display text-lg font-semibold tracking-tight text-brick">MHC</span>
      <span class="hidden text-sm leading-tight text-ink-muted sm:block">
        Martinsville-Henry County<br />Historical Society
      </span>
      <span class="text-sm text-ink-muted sm:hidden">Historical Society</span>
    </a>

    <nav aria-label="Main">
      <ul class="flex flex-wrap justify-end gap-x-5 gap-y-1 text-sm">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
                class="inline-block border-b-2 border-transparent py-0.5 text-ink-muted transition-colors hover:text-brick aria-[current=page]:border-gold aria-[current=page]:font-medium aria-[current=page]:text-ink"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
