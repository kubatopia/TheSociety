---
import site from '../data/site.json';

const links = [
  { href: '/about', label: 'About' },
  { href: '/board', label: 'Board' },
  { href: '/events', label: 'Events' },
  { href: '/news', label: 'News' },
  { href: '/minutes', label: 'Minutes' },
  { href: '/contact', label: 'Contact' },
];

const { pathname } = Astro.url;
---

<header class="border-b border-rule">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-5 py-5">
    <a href="/" class="font-serif text-xl font-semibold tracking-tight">{site.name}</a>

    <nav aria-label="Main">
      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={pathname.startsWith(link.href) ? 'page' : undefined}
                class="text-ink-muted hover:text-ink aria-[current=page]:text-ink aria-[current=page]:font-medium"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
