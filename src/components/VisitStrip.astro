---
import site from '../data/site.json';
const hours = site.hours.split('\n').filter(Boolean);
---

<!-- The three things a visitor actually came for, above the fold on every path in. -->
<section class="border-b border-rule bg-parchment-deep">
  <dl class="mx-auto grid max-w-6xl gap-8 px-5 py-8 sm:grid-cols-3">
    <div>
      <dt class="text-xs font-semibold uppercase tracking-wider text-brick">Open</dt>
      <dd class="mt-2 space-y-0.5 text-sm">{hours.map((line) => <p>{line}</p>)}</dd>
    </div>
    <div>
      <dt class="text-xs font-semibold uppercase tracking-wider text-brick">Find us</dt>
      <dd class="mt-2 text-sm">
        <p>{site.venue}</p>
        <p class="text-ink-muted">{site.address}</p>
      </dd>
    </div>
    <div>
      <dt class="text-xs font-semibold uppercase tracking-wider text-brick">Ask us</dt>
      <dd class="mt-2 text-sm">
        <p><a href={`tel:${site.phone.replace(/[^\d+]/g, '')}`} class="hover:text-brick">{site.phone}</a></p>
        <p><a href={`mailto:${site.email}`} class="break-all text-ink-muted hover:text-brick">{site.email}</a></p>
      </dd>
    </div>
  </dl>
</section>
