---
interface Props {
  sections: Array<{ id: string; label: string }>;
}
const { sections } = Astro.props;
---

<nav aria-label="On this page" class="lg:sticky lg:top-24" data-section-nav>
  <p class="label text-brick">On this page</p>
  <ul class="mt-3 space-y-0.5 border-l border-rule">
    {
      sections.map((section) => (
        <li>
          <a
            href={`#${section.id}`}
            class="-ml-px block border-l-2 border-transparent py-1.5 pl-4 text-[0.9375rem] leading-snug text-ink-muted transition-colors hover:text-brick aria-[current=true]:border-gold aria-[current=true]:font-medium aria-[current=true]:text-ink"
          >
            {section.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  /**
   * Highlights the section currently in view. Progressive enhancement: without
   * JavaScript the list is still a working table of contents.
   *
   * The page may render this more than once (a narrow-screen copy and a sticky
   * one), so every instance is wired up, not just the first.
   */
  const navs = [...document.querySelectorAll<HTMLElement>('[data-section-nav]')];

  if (navs.length > 0) {
    const ids: string[] = [];
    for (const link of navs[0].querySelectorAll('a[href^="#"]')) {
      const id = link.getAttribute('href')?.slice(1);
      if (id) ids.push(id);
    }

    const visible = new Set<string>();
    const paint = () => {
      const current = ids.find((id) => visible.has(id));
      for (const nav of navs) {
        for (const link of nav.querySelectorAll('a[href^="#"]')) {
          const id = link.getAttribute('href')?.slice(1);
          if (id && id === current) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        }
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        }
        paint();
      },
      { rootMargin: '-96px 0px -55% 0px' },
    );

    for (const id of ids) {
      const section = document.getElementById(id);
      if (section) observer.observe(section);
    }
  }
</script>
