---
/**
 * Where an event is, on a map of greater Martinsville.
 *
 * The map is a single image stitched from OpenStreetMap tiles at author time
 * and served from our own domain -- no request leaves the visitor's browser,
 * the same reason the fonts are self-hosted. Its centre pixel is 1 East Main
 * Street, so the pin is drawn dead centre rather than baked into the picture.
 *
 * Because the centre is fixed, an event anywhere else would be pinned in the
 * wrong place: `atTheCourthouse` decides whether a map is honest for this
 * venue, and everywhere else simply gets the address in words.
 */
interface Props {
  location: string;
  /** Tighten or loosen the leading when this sits under prose. */
  class?: string;
}

const { location, class: className = '' } = Astro.props;

/** The museum, the courthouse and the Square share this one address. */
const COURTHOUSE = '1 East Main Street';
const atTheCourthouse = location.includes(COURTHOUSE);

const directions = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(location)}`;
---

<section class:list={['border-t border-rule pt-6', className]}>
  <h2 class="label text-brick">Where</h2>
  <p class="mt-2">{location}</p>

  {
    atTheCourthouse && (
      <figure class="mt-4">
        {/*
          The asset is 4:3, which is far too tall a block under a column of
          prose; cropping to 16:9 keeps the courthouse centred -- object-cover
          trims both edges equally -- and the pin with it.
        */}
        <div class="relative aspect-video overflow-hidden rounded-lg border border-rule">
          <img
            src="/media/martinsville-map.webp"
            alt="Map of greater Martinsville, centred on the historic Henry County courthouse at 1 East Main Street, uptown"
            width="1024"
            height="768"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
          {/* The pin's tip, not its middle, has to land on the centre pixel. */}
          <span
            class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-full"
            aria-hidden="true"
          >
            <svg width="28" height="38" viewBox="0 0 28 38" fill="none">
              <path
                d="M14 37C14 37 26 22.5 26 14A12 12 0 1 0 2 14C2 22.5 14 37 14 37Z"
                fill="var(--color-brick)"
                stroke="var(--color-card)"
                stroke-width="2.5"
              />
              <circle cx="14" cy="14" r="4.5" fill="var(--color-card)" />
            </svg>
          </span>
        </div>

        <figcaption class="mt-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 text-sm">
          <a href={directions} target="_blank" rel="noopener" class="font-semibold text-brick hover:text-brick-bright">
            Open in Maps &rarr;
          </a>
          <span class="text-ink-muted">
            Map data &copy;{' '}
            <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener" class="underline">
              OpenStreetMap contributors
            </a>
          </span>
        </figcaption>
      </figure>
    )
  }
</section>
