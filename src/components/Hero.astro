---
import site from '../data/site.json';

// The hero works with or without a photograph. Until a board member uploads
// one in the CMS, we fall back to a layered brick-and-bark banner rather than
// shipping a broken image.
const hasPhoto = Boolean(site.heroImage);
---

<section class:list={['relative isolate overflow-hidden', hasPhoto ? 'bg-bark-deep' : 'bg-bark']}>
  {
    hasPhoto && (
      <>
        <img
          src={site.heroImage}
          alt={site.heroAlt}
          fetchpriority="high"
          decoding="async"
          class="absolute inset-0 -z-10 h-full w-full object-cover"
        />
        <div
          class="absolute inset-0 -z-10 bg-gradient-to-t from-bark-deep/95 via-bark-deep/60 to-bark-deep/25"
          aria-hidden="true"
        >
        </div>
      </>
    )
  }
  {
    !hasPhoto && (
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(120%_110%_at_15%_0%,var(--color-brick)_0%,transparent_58%)] opacity-70"
        aria-hidden="true"
      />
    )
  }

  <div class="mx-auto max-w-6xl px-5 py-24 sm:py-32 lg:py-40">
    <p class="text-sm font-medium uppercase tracking-[0.18em] text-gold">Martinsville &amp; Henry County, Virginia</p>
    <h1 class="mt-5 max-w-3xl font-display text-4xl font-semibold leading-[1.1] text-parchment sm:text-5xl lg:text-6xl">
      {site.tagline}
    </h1>
    <div class="mt-9 flex flex-wrap gap-3">
      <a
        href="/museum"
        class="rounded-sm bg-gold px-5 py-3 text-sm font-semibold text-bark-deep transition-colors hover:bg-parchment"
      >
        Visit the museum
      </a>
      <a
        href="/events"
        class="rounded-sm border border-parchment/40 px-5 py-3 text-sm font-semibold text-parchment transition-colors hover:border-gold hover:text-gold"
      >
        What's on
      </a>
    </div>
  </div>

  {
    site.heroCredit && (
      <p class="absolute bottom-2 right-4 text-[11px] text-parchment/50">{site.heroCredit}</p>
    )
  }
</section>
