---
import site from '../data/site.json';
import OpenStatus from './OpenStatus.astro';

interface Props {
  title?: string;
  lede?: string;
}
const { title = site.tagline, lede } = Astro.props;
const hasPhoto = Boolean(site.heroImage);
---

<!--
  No background colour on the section itself when there is a photograph: the
  image sits at z-0 and a solid parent background would paint straight over it.
-->
<section class:list={['relative', !hasPhoto && 'bg-bark']}>
  {
    hasPhoto ? (
      <>
        <img
          src={site.heroImage}
          alt={site.heroAlt}
          fetchpriority="high"
          decoding="async"
          class="absolute inset-0 z-0 h-full w-full object-cover object-[center_62%]"
        />
        {/* Two stops, not one: the top scrim carries the nav, the bottom the headline. */}
        <div
          class="absolute inset-0 z-[1] bg-[linear-gradient(180deg,rgba(20,14,8,.66)_0%,rgba(20,14,8,.14)_34%,rgba(20,14,8,.82)_100%)]"
          aria-hidden="true"
        />
      </>
    ) : (
      <div
        class="absolute inset-0 z-0 bg-[radial-gradient(120%_110%_at_15%_0%,var(--color-brick)_0%,transparent_58%)] opacity-70"
        aria-hidden="true"
      />
    )
  }

  <div class="relative z-10 mx-auto flex min-h-[26rem] max-w-6xl flex-col justify-end px-5 pt-40 pb-10 sm:min-h-[34rem] sm:pb-14">
    <OpenStatus tone="hero" />
    <h1 class="mt-4 max-w-[19ch] font-display text-4xl leading-[1.04] text-card sm:text-5xl lg:text-6xl">
      {title}
    </h1>
    {lede && <p class="mt-4 max-w-[46ch] text-card/85">{lede}</p>}
  </div>

  {site.heroCredit && <p class="absolute right-4 bottom-2 z-10 text-[11px] text-card/50">{site.heroCredit}</p>}
</section>
