---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';

interface Props {
  title?: string;
  description?: string;
  /** Full-bleed pages (the home page) lay out their own containers. */
  bleed?: boolean;
  /** Lay the header over a hero photograph instead of on its own ground. */
  overlay?: boolean;
}

const { title, description = site.tagline, bleed = false, overlay = false } = Astro.props;
const pageTitle = title ? `${title} — ${site.shortName}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image" content={new URL(site.heroImage, Astro.site)} />
    <meta property="og:image:alt" content={site.heroAlt} />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body class="antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:rounded focus:bg-brick focus:px-4 focus:py-2 focus:text-parchment"
      >Skip to content</a
    >
    <Header overlay={overlay} />
    <main id="main" class={bleed ? '' : 'mx-auto max-w-6xl px-5 py-14'}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
